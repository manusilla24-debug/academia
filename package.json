{
  "name": "poker-study-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "worker": "node --env-file-if-exists=.env.local --import tsx scripts/worker.ts",
    "seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "import": "node --env-file-if-exists=.env.local --import tsx scripts/import.ts",
    "youtube:sync": "node --env-file-if-exists=.env.local --import tsx scripts/sync.ts",
    "format": "prettier --write src scripts tests *.ts *.mjs README.md docs",
    "curriculum": "node --env-file-if-exists=.env.local --import tsx scripts/curriculum.ts",
    "channel:catalogue": "node --env-file-if-exists=.env.local --import tsx scripts/catalogue.ts",
    "channel:curate": "node --env-file-if-exists=.env.local --import tsx scripts/curate.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.99.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^0.577.0",
    "next": "16.4.1",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.2"
    }
  },
  "type": "module"
}

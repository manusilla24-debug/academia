# Local development: demo login is allowed only outside production.
APP_MODE=local
# Optional: password-only sessions with remote PostgreSQL (APP_MODE=supabase).
# Empty keeps the existing Supabase email/password authentication.
AUTH_MODE=
LOCAL_DEMO_LOGIN=true
LOCAL_PASSWORD=
# Prefer a salted scrypt hash instead of storing the plaintext password.
LOCAL_PASSWORD_HASH=
# Default 12; the owner may explicitly choose another local minimum.
LOCAL_PASSWORD_MIN_LENGTH=12
# Set a random value of at least 32 characters for private local-password sessions.
SESSION_SECRET=
NEXT_TELEMETRY_DISABLED=1
LOCAL_DB_PATH=./data/poker.db
# Optional fixed public origin for CSRF checks (recommended in production).
APP_ORIGIN=
# Production: APP_MODE=supabase; demo login is always disabled in production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
OWNER_USER_ID=
# Supabase transaction pooler URL, SSL enabled. Server/CLI only.
DATABASE_URL=
YOUTUBE_API_KEY=
# Optional OpenAI-compatible chat completions provider. Server/CLI only.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
# Current prices supplied by you, USD per million tokens. No assumed prices.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
